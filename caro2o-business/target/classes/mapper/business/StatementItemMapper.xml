<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.wolfcode.business.appointment.statement.mapper.StatementItemMapper">

    <resultMap type="StatementItem" id="StatementItemResult">
        <result property="id" column="id"/>
        <result property="statementId" column="statement_id"/>
        <result property="itemId" column="item_id"/>
        <result property="itemName" column="item_name"/>
        <result property="itemPrice" column="item_price"/>
        <result property="itemQuantity" column="item_quantity"/>
    </resultMap>

    <sql id="selectStatementItemVo">
        select id, statement_id, item_id, item_name, item_price, item_quantity
        from bus_statement_item
    </sql>

    <select id="selectStatementItemList" parameterType="StatementItem" resultMap="StatementItemResult">
        <include refid="selectStatementItemVo"/>
        <where>
            <if test="statementId != null ">and statement_id = #{statementId}</if>
            <if test="itemId != null ">and item_id = #{itemId}</if>
            <if test="itemName != null  and itemName != ''">and item_name like concat('%', #{itemName}, '%')</if>
            <if test="itemPrice != null ">and item_price = #{itemPrice}</if>
            <if test="itemQuantity != null ">and item_quantity = #{itemQuantity}</if>
        </where>
    </select>

    <select id="selectStatementItemById" parameterType="Long" resultMap="StatementItemResult">
        <include refid="selectStatementItemVo"/>
        where id = #{id}
    </select>

    <select id="selectStatementItemByStatementId" resultMap="StatementItemResult">
        <include refid="selectStatementItemVo"/>
        where statement_id = #{statementId}
    </select>

    <insert id="insertStatementItem" parameterType="StatementItem" useGeneratedKeys="true" keyProperty="id">
        insert into bus_statement_item
        values
        <foreach collection="list" separator="," item="item">
            (null,#{item.statementId},#{item.itemId},#{item.itemName},#{item.itemPrice},#{item.itemQuantity})
        </foreach>
    </insert>

    <update id="updateStatementItem" parameterType="StatementItem">
        update bus_statement_item
        <trim prefix="SET" suffixOverrides=",">
            <if test="statementId != null">statement_id = #{statementId},</if>
            <if test="itemId != null">item_id = #{itemId},</if>
            <if test="itemName != null">item_name = #{itemName},</if>
            <if test="itemPrice != null">item_price = #{itemPrice},</if>
            <if test="itemQuantity != null">item_quantity = #{itemQuantity},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteStatementItemById" parameterType="Long">
        delete
        from bus_statement_item
        where id = #{id}
    </delete>

    <delete id="deleteStatementItemByIds" parameterType="String">
        delete from bus_statement_item where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <delete id="deleteStatementItemBStatementId">
        delete from bus_statement_item where statement_id = #{statementId}
    </delete>
</mapper>