<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.wolfcode.client.contact.mapper.CustomerLinkmaneMapper">
    
    <resultMap type="CustomerLinkmane" id="CustomerLinkmaneResult">
        <result property="id"    column="id"    />
        <result property="customerId"    column="customer_id"    />
        <result property="linkman"    column="linkman"    />
        <result property="gender"    column="gender"    />
        <result property="age"    column="age"    />
        <result property="phone"    column="phone"    />
        <result property="position"    column="position"    />
        <result property="positionState"    column="position_state"    />
        <result property="department"    column="department"    />
        <result property="inputUser"    column="input_user"    />
        <result property="inputTime"    column="input_time"    />
    </resultMap>

    <sql id="selectCustomerLinkmaneVo">
        select id, customer_id, linkman, gender, age, phone, position, position_state, department, input_user, input_time from customer_linkmane
    </sql>

    <select id="selectCustomerLinkmaneList" parameterType="CustomerLinkmane" resultMap="CustomerLinkmaneResult">
        <include refid="selectCustomerLinkmaneVo"/>
        <where>  
            <if test="params.keyword != null and params.keyword != ''"> and (linkman like concat('%', #{params.keyword}, '%') or phone like concat('%', #{params.keyword}, '%'))</if>

            <if test="positionState != null "> and position_state = #{positionState}</if>
        </where>
    </select>
    
    <select id="selectCustomerLinkmaneById" parameterType="Long" resultMap="CustomerLinkmaneResult">
        <include refid="selectCustomerLinkmaneVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertCustomerLinkmane" parameterType="CustomerLinkmane">
        insert into customer_linkmane
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="customerId != null">customer_id,</if>
            <if test="linkman != null">linkman,</if>
            <if test="gender != null">gender,</if>
            <if test="age != null">age,</if>
            <if test="phone != null">phone,</if>
            <if test="position != null">position,</if>
            <if test="positionState != null">position_state,</if>
            <if test="department != null">department,</if>
            <if test="inputUser != null">input_user,</if>
            <if test="inputTime != null">input_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="customerId != null">#{customerId},</if>
            <if test="linkman != null">#{linkman},</if>
            <if test="gender != null">#{gender},</if>
            <if test="age != null">#{age},</if>
            <if test="phone != null">#{phone},</if>
            <if test="position != null">#{position},</if>
            <if test="positionState != null">#{positionState},</if>
            <if test="department != null">#{department},</if>
            <if test="inputUser != null">#{inputUser},</if>
            <if test="inputTime != null">#{inputTime},</if>
         </trim>
    </insert>

    <update id="updateCustomerLinkmane" parameterType="CustomerLinkmane">
        update customer_linkmane
        <trim prefix="SET" suffixOverrides=",">
            <if test="customerId != null">customer_id = #{customerId},</if>
            <if test="linkman != null">linkman = #{linkman},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="age != null">age = #{age},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="position != null">position = #{position},</if>
            <if test="positionState != null">position_state = #{positionState},</if>
            <if test="department != null">department = #{department},</if>
            <if test="inputUser != null">input_user = #{inputUser},</if>
            <if test="inputTime != null">input_time = #{inputTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCustomerLinkmaneById" parameterType="Long">
        delete from customer_linkmane where id = #{id}
    </delete>

    <delete id="deleteCustomerLinkmaneByIds" parameterType="String">
        delete from customer_linkmane where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>