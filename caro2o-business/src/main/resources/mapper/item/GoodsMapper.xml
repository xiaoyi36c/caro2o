<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.wolfcode.item.goods.mapper.GoodsMapper">

    <resultMap type="Goods" id="GoodsResult">
        <result property="id"    column="id"    />
        <result property="goodsName"    column="goods_name"    />
        <result property="goodsCover"    column="goods_cover"    />
        <result property="categoryId"    column="category_id"    />
        <result property="brand"    column="brand"    />
        <result property="spec"    column="spec"    />
        <result property="goodsDesc"    column="goods_desc"    />
    </resultMap>

    <sql id="selectGoodsVo">
        select id, goods_name, goods_cover, category_id, brand, spec, goods_desc from goods
    </sql>

    <select id="selectGoodsList" parameterType="Goods" resultMap="GoodsResult">
        <include refid="selectGoodsVo"/>
        <where>
<if test="params.keyword != null and params.keyword != ''">
    and (goods_name like concat('%', #{params.keyword}, '%')
    or brand like concat('%', #{params.keyword}, '%')
    or spec like concat('%', #{params.keyword}, '%')
    or goods_desc like concat('%', #{params.keyword}, '%'))
</if>
<if test="categoryId != null and categoryId != ''">
    and category_id = #{categoryId}
</if>
        </where>
    </select>

    <select id="selectGoodsById" parameterType="Long" resultMap="GoodsResult">
        <include refid="selectGoodsVo"/>
        where id = #{id}
    </select>

    <resultMap id="Subsidiary" type="cn.wolfcode.item.goods.domain.Subsidiary">
        <result property="amounts" column="amounts"/>
        <result property="price" column="price"/>
        <result property="busiDate" column="busi_date"/>
        <result property="type" column="type"/>
        <result property="id" column="id"/>
        <result property="goodsName" column="goods_name"/>
        <result property="brand" column="brand"/>
        <result property="storeName" column="store_name"/>
    </resultMap>

    <select id="selectSubsidiaryByGoodsId" resultMap="Subsidiary">
        select sbi.amounts,
               sbi.price,
               sb.busi_date,
               sb.type,
               sb.id,
               g.goods_name,
               g.brand,
               s.store_name
        from stock_bill_item sbi
                 join stock_bill sb on sbi.bill_id = sb.id
                 join goods g on sbi.goods_id = g.id
                 join store s on sb.store_id = s.id
        where g.id = #{goodsId}
    </select>
    <select id="selectGoodsByCategoryId"  resultMap="GoodsResult">
        select goods.* from goods where category_id = #{id}
    </select>

    <insert id="insertGoods" parameterType="Goods" useGeneratedKeys="true" keyProperty="id">
        insert into goods
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="goodsName != null">goods_name,</if>
            <if test="goodsCover != null">goods_cover,</if>
            <if test="categoryId != null">category_id,</if>
            <if test="brand != null">brand,</if>
            <if test="spec != null">spec,</if>
            <if test="goodsDesc != null">goods_desc,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="goodsName != null">#{goodsName},</if>
            <if test="goodsCover != null">#{goodsCover},</if>
            <if test="categoryId != null">#{categoryId},</if>
            <if test="brand != null">#{brand},</if>
            <if test="spec != null">#{spec},</if>
            <if test="goodsDesc != null">#{goodsDesc},</if>
        </trim>
    </insert>

    <update id="updateGoods" parameterType="Goods">
        update goods
        <trim prefix="SET" suffixOverrides=",">
            <if test="goodsName != null">goods_name = #{goodsName},</if>
            <if test="goodsCover != null">goods_cover = #{goodsCover},</if>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="brand != null">brand = #{brand},</if>
            <if test="spec != null">spec = #{spec},</if>
            <if test="goodsDesc != null">goods_desc = #{goodsDesc},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteGoodsById" parameterType="Long">
        delete from goods where id = #{id}
    </delete>

    <delete id="deleteGoodsByIds" parameterType="String">
        delete from goods where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>